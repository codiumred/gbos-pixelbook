--- /dev/null
+++ b/arch/x86/kernel/isa_emu_fastpath_table.h
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Generated by pixelbook/isa_emu/gen_fastpath.py. Contains no code: offsets, 8 opcode bytes at the
+ * trap site and a hash per known variant of BoringSSL sha256_block_data_order_hw and of the SHA-NI
+ * path of sha1_block_data_order. */
+static const struct isa_fastpath isa_fastpaths[] = {
+	{ ISA_FP_SHA256_BLOCKS, { 0x0f, 0x38, 0xcb, 0xd1, 0x66, 0x0f, 0x70, 0xc0 }, 829, 107, 828, 3, 4, 0xb31e2a368c69d94eULL },	/* 39 ELFs */
+	{ ISA_FP_SHA1_BLOCKS, { 0x0f, 0x38, 0xc9, 0xe5, 0x66, 0x0f, 0x6f, 0xd0 }, 635, 107, 634, 13, 4, 0x248b6e382b110996ULL },	/* 25 ELFs */
+};
